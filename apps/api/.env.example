# Copie para .env — o .env real nunca vai para o git.
#
# PRODUÇÃO: todos os valores abaixo são de DESENVOLVIMENTO. Gere segredos
# próprios por ambiente e defina também POSTGRES_PASSWORD e
# APITOFUT_APP_PASSWORD para o contêiner do banco (ver docker-compose.yml).

# Conexão da APLICAÇÃO: papel sem superuser, sujeito ao RLS (migration 06).
# Sem app.current_org definido, enxerga apenas competições públicas.
DATABASE_URL="postgresql://apitofut_app:apitofut_app_dev@localhost:5433/apitofut?schema=public"

# Conexão do CLI do Prisma (db pull / migrate diff): precisa do dono, que
# enxerga o catálogo inteiro. NUNCA use esta URL em runtime — é superuser
# e ignora o RLS.
DIRECT_URL="postgresql://apitofut:apitofut_dev@localhost:5433/apitofut?schema=public"

PORT=3000

# Assinatura HMAC dos tokens de sessão. Gere um por ambiente:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# A API recusa subir em produção enquanto este valor contiver "troque-me".
AUTH_SEGREDO="troque-me-em-producao-com-32-caracteres-ou-mais"
