  email          String           @unique @db.Citext
  senha_hash     String
  perfil         perfil_usuario   @default(organizador)
  situacao       situacao_usuario @default(pendente)
  ultimo_acesso  DateTime?        @db.Timestamptz(6)
  liberado_por   String?          @db.Uuid
  liberado_em    DateTime?        @db.Timestamptz(6)
  criado_em      DateTime         @default(now()) @db.Timestamptz(6)
  atualizado_em  DateTime         @default(now()) @db.Timestamptz(6)
  competicoes    competicoes[]
  jogo_eventos   jogo_eventos[]
  usuarios       usuarios?        @relation("usuariosTousuarios", fields: [liberado_por], references: [id], onUpdate: NoAction)
  other_usuarios usuarios[]       @relation("usuariosTousuarios")
  organizacoes   organizacoes?    @relation(fields: [organizacao_id], references: [id], onUpdate: NoAction)

  @@index([organizacao_id], map: "idx_usuarios_organizacao")
  @@index([situacao], map: "idx_usuarios_situacao", where: raw("(situacao = 'pendente'::situacao_usuario)"))
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model categoria_coluna_extra {
  categoria_id    String          @db.Uuid
  time_id         String          @db.Uuid
  valor           Int             @default(0)
  motivo          String?
  criado_em       DateTime        @default(now()) @db.Timestamptz(6)
  atualizado_em   DateTime        @default(now()) @db.Timestamptz(6)
  categoria_times categoria_times @relation(fields: [categoria_id, time_id], references: [categoria_id, time_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_coluna_extra_vinculo")

  @@id([categoria_id, time_id])
}

