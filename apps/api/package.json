{
  "name": "@apitofut/api",
  "version": "0.1.0",
  "private": true,
  "description": "API do ApitoFut — NestJS sobre PostgreSQL",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node ../../db/migrar.mjs && node dist/main.js",
    "start:dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch dist/main.js",
    "start:prod": "node ../../db/migrar.mjs && node dist/main.js",
    "test": "tsc -p tsconfig.spec.json && node --test --test-concurrency=1 \"dist/**/*.spec.js\"",
    "db:pull": "prisma db pull && prisma generate",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.0.0",
    "pg": "^8.22.0",
    "qrcode-svg": "^1.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "prisma": "^7.0.0",
    "typescript": "^5.7.0"
  }
}
