# =====================================================================
#  ApitoFut — variáveis de ambiente
#
#  Copie para .env e ajuste. O .env NUNCA é versionado (ver .gitignore).
#
#  Os padrões abaixo servem só para desenvolvimento local. A API RECUSA
#  subir em produção com o AUTH_SEGREDO de exemplo ou com menos de 32
#  caracteres — é proposital.
# =====================================================================

# ── Banco de dados ───────────────────────────────────────────────────
# Dono do banco: aplica migrações e ignora RLS. Não é quem a API usa.
POSTGRES_PASSWORD=troque-esta-senha

# Papel da aplicação: é com ele que a API conecta, e ele OBEDECE ao RLS.
# São dois papéis de propósito — ver db/06-rls.sql.
APITOFUT_APP_PASSWORD=troque-esta-tambem

# Aplicar o db/02-seed.sql (Copa Premium de demonstração)?
# Deixe vazio em qualquer ambiente exposto: o seed cria contas conhecidas
# com senha "demo", inclusive um superadmin. Num banco limpo, a primeira
# conta cadastrada vira superadmin sozinha (migration 15).
# APITOFUT_SEED=1

# ── API ──────────────────────────────────────────────────────────────
# Assina os tokens de sessão (HMAC-SHA256). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SEGREDO=gere-um-segredo-com-pelo-menos-32-caracteres

# Base das URLs de imagem gravadas no banco. O banco guarda só o caminho
# (/uploads/…), então trocar o domínio da API não invalida escudo antigo.
ARQUIVOS_BASE_URL=http://localhost:3000

# Endereço do portal público. Usada nos links que a API gera (QR da
# carteirinha) E servida ao painel em GET /configuracao — é de lá que saem
# o link de convite das equipes e os atalhos para o portal.
# Um lugar só: trocar aqui basta, sem rebuild de nada.
PORTAL_URL=http://localhost:3001

# ── Painel (SPA) ─────────────────────────────────────────────────────
# ATENÇÃO: embutida no bundle no momento do BUILD. Precisa ser a URL que o
# NAVEGADOR alcança — não o nome do serviço interno. Mudou? Rebuild.
#
# É a ÚNICA do painel. O endereço do portal não mora aqui: o painel o
# pergunta à API em runtime (GET /configuracao), justamente para trocar de
# domínio não exigir reconstruir imagem.
VITE_API_URL=http://localhost:3000

# ── Portas locais (opcional) ─────────────────────────────────────────
# API_PORT=3000
# PORTAL_PORT=3001
# PAINEL_PORT=5173
